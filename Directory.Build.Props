<Project>
    <!-- Project properties -->
    <PropertyGroup>
        <TargetFramework>net472</TargetFramework>
        <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
        <GenerateDocumentationFile>false</GenerateDocumentationFile>
        <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
        <LangVersion>8.0</LangVersion>
        <DebugSymbols>true</DebugSymbols>
        <DebugType>full</DebugType>
        <NoWarn>$(NoWarn);CS8509;CS0184</NoWarn>
        <NoError>$(NoError);CS1591;WPF0041;WPF0150;CS0168;WPF0130;WPF0132;CS0184;CS8509;CS0184;CS8602;CS8618;CS8602</NoError>
        <UseWPF>true</UseWPF>
    </PropertyGroup>
    
    <ItemDefinitionGroup>
	  <Reference>
		<Private>False</Private>
	  </Reference>
	  <ProjectReference>
		 <Private>False</Private>
	  </ProjectReference>
	</ItemDefinitionGroup>

    <!-- Add the references for all projects and targets -->

    <ItemGroup>
        <None Remove="**\*.png;**\*.jpg;**\*.ico;**\*.ttf" />
        <Resource Include="**\*.png;**\*.jpg;**\*.ico;**\*.ttf" />
    </ItemGroup>

</Project>